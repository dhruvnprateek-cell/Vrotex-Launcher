<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@Launcher_AppID@</id>
  <name>@Launcher_DisplayName@</name>
  <summary>A fast, organized launcher for Minecraft instances</summary>
  <developer id="org.vortexlauncher">
    <name>Vortex Launcher Contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>Vortex Launcher is a Prism-based desktop launcher for managing isolated Minecraft installations.</p>
    <ul>
      <li>Create vanilla, modded, and Modrinth instances</li>
      <li>Manage mods, resource packs, shader packs, servers, and worlds per instance</li>
      <li>Choose Java runtime, memory limits, and performance options</li>
      <li>Use Microsoft authentication with a client ID you provide, or local offline profiles</li>
      <li>Customize themes, language, and accessibility settings</li>
    </ul>
  </description>
  <releases>
    <release version="@Launcher_VERSION_NAME@" date="@Launcher_BUILD_TIMESTAMP@"/>
  </releases>
  <launchable type="desktop-id">@Launcher_AppID@.desktop</launchable>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
</component>
